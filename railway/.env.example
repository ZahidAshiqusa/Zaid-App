# Zaid Ashiq Chat - Railway Backend Environment Variables
# Set these inside Railway Dashboard -> Your Service -> Variables

# Server
PORT=3000
CORS_ORIGIN=*
APP_NAME=Zaid Ashiq Chat
OWNER_NUMBER=
TIMEZONE=Asia/Karachi

# PostgreSQL Database URL (Railway Postgres or Supabase Postgres connection string)
# Used for 24/7 persistent WhatsApp Baileys session backup across Railway restarts/redeploys
DATABASE_URL=

# Supabase Configuration (Optional alternative/secondary cloud sync)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Giphy API Key (for GIF search & direct GIF sending in the Android app)
GIPHY_API_KEY=

# Optional Truecaller & SIM Database API Overrides (built-in APIs work automatically; set these to use private tokens)
TRUECALLER_API_URL=
TRUECALLER_TOKEN=
SIM_DB_API_URL=
SIM_DB_API_KEY=
