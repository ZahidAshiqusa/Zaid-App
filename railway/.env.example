# Railway Backend Environment Variables for Zaid Ashiq Chat
# Add these in Railway Dashboard -> Your Service -> Variables

# Server Settings
PORT=3000
CORS_ORIGIN=*
BOT_NAME=Zaid Ashiq Chat
BOT_OWNER=Zaid Ashiq
OWNER_NUMBER=
PREFIX=.
COMMAND_MODE=public
BUTTONMODE=true
TIMEZONE=Asia/Karachi

# PostgreSQL Database URL (provided by Railway Postgres or Supabase)
DATABASE_URL=

# Supabase Configuration (for 24/7 Cloud Session Persistence & Sync)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Giphy API Key (for GIF Search & Send inside Android Chat + Downloader menu)
GIPHY_API_KEY=

# Automation Defaults
AUTO_STATUS_REACT=true
AUTO_STATUS_REPLY=false
AUTOREAD=false
AUTO_REAUTH_ENABLED=true
NEVER_AUTO_LOGOUT=true
STATUS_UPLOADER_ENABLED=true
STATUS_VOICE_NOTE_ENABLED=true
