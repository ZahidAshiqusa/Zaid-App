# Zaid Ashiq Chat - Production Android Environment Variables (Configure via AI Studio Secrets Panel)
# Server-only database credentials (DATABASE_URL, SUPABASE_SECRET_KEY) belong strictly in railway/.env.example on Railway.

# Public HTTPS URL of your deployed Railway backend folder
RAILWAY_BACKEND_URL=https://zaid-app-production.up.railway.app

# Public Supabase project URL & publishable anon key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Giphy API Key for instant GIF search & send inside the Chat + Downloader menu
GIPHY_API_KEY=your_giphy_api_key

# Optional Default Profile / App Metadata
OWNER_NUMBER=UNSET
TIMEZONE=Asia/Karachi