# Zaid Ashiq Chat - Android App Environment Variables (Configure via AI Studio Secrets Panel)
# Note: Sensitive server credentials (DATABASE_URL, SUPABASE_SECRET_KEY) belong in railway/.env.example on Railway.

# Public HTTPS URL of your deployed Railway backend folder (e.g. https://your-app.up.railway.app)
RAILWAY_BACKEND_URL=https://your-railway-backend.up.railway.app

# Public Supabase project URL & publishable anon key (optional direct sync diagnostics)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Giphy API Key for instant GIF search & send inside the Chat + Downloader menu
GIPHY_API_KEY=your_giphy_api_key